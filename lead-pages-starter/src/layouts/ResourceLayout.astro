---
import { Analytics } from '@vercel/analytics/astro';

interface Props {
  title: string;
  headline: string;
  subtitle: string;
  pdfUrl: string;
  valueProps: string[];
  ctaText: string;
  previewDescription: string;
  pages: number;
  type: string;
  slug: string;
}

const { title, headline, subtitle, pdfUrl, valueProps, ctaText, previewDescription, pages, type, slug } = Astro.props;

const typeLabels: Record<string, string> = {
  'guide': 'Gids',
  'cheatsheet': 'Cheatsheet',
  'checklist': 'Checklist',
  'quick-reference': 'Snelreferentie',
  'how-to-guide': 'Stappenplan',
};
const typeLabel = typeLabels[type] || 'Gids';
const badge = `Gratis ${pages}-pagina ${typeLabel}`;
---

<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={subtitle} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --background:   #0D0D0D;
      --foreground:   #FAFAFA;
      --card:         #1A1A1A;
      --secondary:    #262626;
      --muted:        #2E2E2E;
      --muted-fg:     #A6A6A6;
      --accent:       #FFD500;
      --accent-fg:    #0D0D0D;
      --border:       #333333;
      --radius:       0.75rem;
    }
    body { background: var(--background); color: var(--foreground); }
    .font-display { font-family: 'Oswald', sans-serif; text-transform: uppercase; }
    .font-body    { font-family: 'Inter', sans-serif; }
    .card-glow       { box-shadow: 0 0 30px rgba(255,255,255,0.08); }
    .card-glow:hover { box-shadow: 0 0 40px rgba(255,255,255,0.15); }
  </style>
</head>
<body class="font-body antialiased" style="background:#0D0D0D; color:#FAFAFA;">

  <!-- Hero -->
  <section style="background:#0D0D0D; padding: 4rem 0 3rem;">
    <div style="max-width:720px; margin:0 auto; padding:0 1.5rem;">

      <!-- Badge -->
      <div style="margin-bottom:1.5rem;">
        <span style="display:inline-block; background:#FFD500; color:#0D0D0D; font-family:'Oswald',sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; font-size:0.75rem; padding:0.4rem 1rem; border-radius:0.375rem;">
          {badge}
        </span>
      </div>

      <!-- Headline -->
      <h1 style="font-family:'Oswald',sans-serif; font-weight:700; text-transform:uppercase; font-size:clamp(2.2rem,6vw,3.5rem); line-height:1.05; letter-spacing:-0.01em; color:#FAFAFA; margin-bottom:1.25rem;">
        {headline}
      </h1>

      <!-- Subtitle -->
      <p style="font-size:1.1rem; color:#A6A6A6; max-width:600px; margin-bottom:2.5rem; line-height:1.7;">
        {subtitle}
      </p>

      <!-- Value Props -->
      <div style="margin-bottom:2.5rem; display:flex; flex-direction:column; gap:0.75rem;">
        {valueProps.map((prop) => (
          <div style="display:flex; align-items:flex-start; gap:0.75rem;">
            <span style="color:#FFD500; font-weight:700; font-size:1rem; margin-top:0.1rem; flex-shrink:0;">✓</span>
            <span style="color:#A6A6A6; font-size:0.95rem;">{prop}</span>
          </div>
        ))}
      </div>

      <!-- CTA knop -->
      <a
        href="#formulier"
        style="display:inline-block; background:#FFD500; color:#0D0D0D; font-family:'Oswald',sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; font-size:0.9rem; padding:0.9rem 2rem; border-radius:0.75rem; text-decoration:none; transition:opacity 0.2s;"
        onmouseover="this.style.opacity='0.85'"
        onmouseout="this.style.opacity='1'"
      >
        {ctaText} ↓
      </a>
    </div>
  </section>

  <!-- Scheidingslijn -->
  <div style="border-top:1px solid #333333;"></div>

  <!-- Formulier sectie -->
  <section id="formulier" style="background:#0D0D0D; padding:4rem 0;">
    <div style="max-width:720px; margin:0 auto; padding:0 1.5rem;">
      <div style="background:#1A1A1A; border:1px solid #333333; border-radius:0.75rem; padding:2.5rem 2rem; box-shadow:0 0 30px rgba(255,255,255,0.08);">

        <p style="font-family:'Oswald',sans-serif; text-transform:uppercase; letter-spacing:0.12em; font-size:0.7rem; color:#A6A6A6; margin-bottom:0.5rem;">Directe toegang</p>
        <h2 style="font-family:'Oswald',sans-serif; font-weight:700; text-transform:uppercase; font-size:1.6rem; color:#FAFAFA; margin-bottom:0.5rem;">{title}</h2>
        <p style="color:#A6A6A6; font-size:0.9rem; margin-bottom:2rem;">{previewDescription}</p>

        <!-- Formulier -->
        <form id="lead-form" style="display:flex; flex-direction:column; gap:1rem; max-width:400px;">
          <div>
            <label for="name" style="display:block; font-family:'Oswald',sans-serif; text-transform:uppercase; letter-spacing:0.1em; font-size:0.7rem; color:#A6A6A6; margin-bottom:0.4rem;">Voornaam</label>
            <input
              type="text" id="name" name="name" required placeholder="Jouw voornaam"
              style="width:100%; padding:0.75rem 1rem; background:#2E2E2E; border:1px solid #333333; border-radius:0.75rem; color:#FAFAFA; font-size:0.95rem; outline:none; box-sizing:border-box;"
              onfocus="this.style.borderColor='#FFD500'" onblur="this.style.borderColor='#333333'"
            />
          </div>
          <div>
            <label for="email" style="display:block; font-family:'Oswald',sans-serif; text-transform:uppercase; letter-spacing:0.1em; font-size:0.7rem; color:#A6A6A6; margin-bottom:0.4rem;">E-mailadres</label>
            <input
              type="email" id="email" name="email" required placeholder="jij@voorbeeld.com"
              style="width:100%; padding:0.75rem 1rem; background:#2E2E2E; border:1px solid #333333; border-radius:0.75rem; color:#FAFAFA; font-size:0.95rem; outline:none; box-sizing:border-box;"
              onfocus="this.style.borderColor='#FFD500'" onblur="this.style.borderColor='#333333'"
            />
          </div>
          <button
            type="submit"
            style="background:#FFD500; color:#0D0D0D; font-family:'Oswald',sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; font-size:0.9rem; padding:0.9rem 1.5rem; border:none; border-radius:0.75rem; cursor:pointer; transition:opacity 0.2s;"
            onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'"
          >
            {ctaText}
          </button>
          <p style="font-size:0.75rem; color:#A6A6A6; text-align:center;">Geen spam. Uitschrijven op elk moment.</p>
        </form>

        <!-- PDF reveal -->
        <div id="resource-reveal" style="display:none; padding-top:1.5rem;">
          <div style="border-left:3px solid #FFD500; padding-left:1rem; margin-bottom:1.5rem;">
            <p style="font-family:'Oswald',sans-serif; text-transform:uppercase; letter-spacing:0.1em; font-size:0.7rem; color:#A6A6A6; margin-bottom:0.25rem;">Klaar!</p>
            <p style="color:#A6A6A6; font-size:0.9rem;">Klik hieronder om je {typeLabel.toLowerCase()} te bekijken of downloaden.</p>
          </div>
          <a
            href={pdfUrl} target="_blank" rel="noopener noreferrer"
            style="display:inline-flex; align-items:center; gap:0.5rem; background:#FFD500; color:#0D0D0D; font-family:'Oswald',sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; font-size:0.9rem; padding:0.9rem 1.75rem; border-radius:0.75rem; text-decoration:none;"
          >
            ↓ Download {typeLabel}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Body content (markdown) -->
  <div style="border-top:1px solid #333333;"></div>
  <section style="background:#0D0D0D; padding:4rem 0;">
    <div style="max-width:720px; margin:0 auto; padding:0 1.5rem;">
      <div id="body-content">
        <slot />
      </div>
    </div>
  </section>

  <!-- Footer -->
  <div style="border-top:1px solid #333333;"></div>
  <footer style="background:#0D0D0D; padding:2rem; text-align:center; font-family:'Oswald',sans-serif; text-transform:uppercase; letter-spacing:0.12em; font-size:0.7rem; color:#A6A6A6;">
    &copy; {new Date().getFullYear()} Barbenders Belgium
  </footer>

  <!-- Markdown stijlen -->
  <style>
    #body-content h2 {
      font-family: 'Oswald', sans-serif;
      font-weight: 700;
      text-transform: uppercase;
      font-size: 1.4rem;
      color: #FAFAFA;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid #333333;
      letter-spacing: 0.03em;
    }
    #body-content h3 {
      font-family: 'Oswald', sans-serif;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 1.1rem;
      color: #FAFAFA;
      margin-top: 1.75rem;
      margin-bottom: 0.75rem;
    }
    #body-content p {
      color: #A6A6A6;
      line-height: 1.75;
      margin-bottom: 1rem;
      font-size: 0.95rem;
    }
    #body-content strong {
      color: #FAFAFA;
      font-weight: 700;
    }
    #body-content ul, #body-content ol {
      padding-left: 1.25rem;
      margin-bottom: 1rem;
    }
    #body-content li {
      color: #A6A6A6;
      margin-bottom: 0.5rem;
      font-size: 0.95rem;
      line-height: 1.6;
    }
    #body-content a {
      color: #FFD500;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  </style>

  <!-- Formulier logica -->
  <script define:vars={{ slug }}>
    const form = document.getElementById('lead-form');
    const reveal = document.getElementById('resource-reveal');

    async function captureLead(name, email) {
      const res = await fetch('/api/capture-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, resource: slug }),
      });
      if (!res.ok) throw new Error('Failed');
    }

    function showResource() {
      form.classList.add('hidden');
      form.style.display = 'none';
      reveal.style.display = 'block';
    }

    const params = new URLSearchParams(window.location.search);
    const mcName = params.get('name') || params.get('first_name') || '';
    const mcEmail = params.get('email') || '';

    if (mcName && mcEmail) {
      captureLead(mcName, mcEmail).catch(() => {});
      showResource();
    } else if (mcEmail) {
      document.getElementById('email').value = mcEmail;
    } else if (mcName) {
      document.getElementById('name').value = mcName;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      const originalText = btn.textContent;
      btn.textContent = 'Even wachten...';
      btn.disabled = true;

      const name = form.querySelector('#name').value.trim();
      const email = form.querySelector('#email').value.trim();

      try {
        await captureLead(name, email);
        showResource();
      } catch (err) {
        btn.textContent = originalText;
        btn.disabled = false;
        showResource();
      }
    });
  </script>
  <Analytics />
</body>
</html>
